+// 기존 공개 진입점은 문맥과 재사용 없이 원래 알고리듬을 실행합니다.
+ICPRegistrationTools::RESULT_TYPE ICPRegistrationTools::Register(
+	GenericIndexedCloudPersist* model, GenericIndexedMesh* mesh, GenericIndexedCloudPersist* data,
+	const Parameters& params, ScaledTransformation& transform, double& rms, unsigned& count,
+	GenericProgressCallback* progress)
+{
+	return RegisterInternal(model, mesh, data, params, transform, rms, count, progress, nullptr);
+}
+
+// 호출 범위의 계측과 격자 수명을 끝내고 오류와 취소 사유를 확정합니다.
+ICPRegistrationTools::RESULT_TYPE ICPRegistrationTools::RegisterWithMeshContext(
+	GenericIndexedCloudPersist* model, GenericIndexedMesh* mesh, GenericIndexedCloudPersist* data,
+	const Parameters& params, ScaledTransformation& transform, double& rms, unsigned& count,
+	ICPMeshRegistrationContext& context, GenericProgressCallback* progress)
+{
+	context.statistics = ICPMeshRegistrationContext::Statistics();
+	const auto started = std::chrono::steady_clock::now();
+	const RESULT_TYPE result = (!mesh || params.useC2MSignedDistances)
+		? ICP_ERROR_INVALID_INPUT : RegisterInternal(model, mesh, data, params, transform, rms, count, progress, &context);
+	context.statistics.total_seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
+	if (result == ICP_ERROR_CANCELED_BY_USER || (progress && progress->isCancelRequested()))
+		context.statistics.stop_reason = "CANCELLED";
+	else if (result >= ICP_ERROR)
+		context.statistics.stop_reason = "ERROR";
+	else if (result == ICP_NOTHING_TO_DO && context.statistics.stop_reason == std::string("ERROR"))
+		context.statistics.stop_reason = "NOTHING_TO_DO";
+	return result;
+}
