+	struct ICPStageTimer
+	{
+		double* destination = nullptr;
+		std::chrono::steady_clock::time_point started;
+		// 이전 구간을 닫은 뒤 다음 구간의 계측을 시작합니다.
+		void select(double* next)
+		{
+			const auto now = std::chrono::steady_clock::now();
+			if (destination) *destination += std::chrono::duration<double>(now - started).count();
+			destination = next;
+			started = now;
+		}
+		// 열린 마지막 구간을 조기 반환 시에도 반영합니다.
+		~ICPStageTimer() { select(nullptr); }
+	};
+}
